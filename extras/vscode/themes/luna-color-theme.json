  "tokenColors": [
    {
      "settings": {
        "foreground": "#e4e4e8"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#7c7c7c", "fontStyle": "italic" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator"],
      "settings": { "foreground": "#a8a8a8" }
    },
    {
      "name": "Keyword, storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
      "settings": { "foreground": "#e19067" }
    },
    {
      "name": "Operator",
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#e19067" }
    },
    {
      "name": "Numbers",
      "scope": ["constant.numeric"],
      "settings": { "foreground": "#e19067" }
    },
    {
      "name": "Language constants",
      "scope": ["constant.language", "variable.language.this", "constant.language.boolean"],
      "settings": { "foreground": "#e19067" }
    },
    {
      "name": "Function / method calls and definitions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "variable.function"
      ],
      "settings": { "foreground": "#75a1c7" }
    },
    {
      "name": "Types, classes, traits",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "entity.name.tag",
        "meta.jsx.children entity.name.tag"
      ],
      "settings": { "foreground": "#c4a8d6" }
    },
    {
      "name": "Constants",
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#c4a8d6" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#9eb38e" }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": { "foreground": "#9eb38e" }
    },
    {
      "name": "Escape characters",
      "scope": ["constant.character.escape"],
      "settings": { "foreground": "#c2916a" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#e4e4e8" }
    },
    {
      "name": "Object properties",
      "scope": ["variable.other.property", "variable.other.object.property", "meta.object-literal.key"],
      "settings": { "foreground": "#b8b8b8" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter"],
      "settings": { "foreground": "#e4e4e8" }
    },
    {
      "name": "Attributes / JSX props",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c2916a" }
    },
    {
      "name": "Macros / preprocessor",
      "scope": ["entity.name.function.preprocessor", "meta.preprocessor", "keyword.other.unit"],
      "settings": { "foreground": "#e19067", "fontStyle": "bold" }
    },
    {
      "name": "Markup headings",
      "scope": ["markup.heading"],
      "settings": { "foreground": "#e19067", "fontStyle": "bold" }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#f0e0d6", "fontStyle": "bold" }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#f0e0d6", "fontStyle": "italic" }
    },
    {
      "name": "Markup links",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": { "foreground": "#75a1c7", "fontStyle": "underline" }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": { "foreground": "#a8a8a8", "fontStyle": "italic" }
    },
    {
      "name": "Markup raw / code",
      "scope": ["markup.raw", "markup.inline.raw"],
      "settings": { "foreground": "#c2916a" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#6fbe80" }
    },
    {
      "name": "Diff deleted",
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#e08585" }
    },
    {
      "name": "Diff changed",
      "scope": ["markup.changed"],
      "settings": { "foreground": "#c2916a" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#e08585" }
    }
  ]
}
